# Settings used only by the browser tests ("npm run build:e2e").
# The AI address below is fake: the tests catch requests to it and answer
# with a fixed reply, so no real AI or Make.com scenario is needed.
VITE_AI_WEBHOOK_URL=https://ai-check.test.invalid/hook
# Empty on purpose, so test runs never send rows to the real Google Sheet.
VITE_WEBHOOK_URL=

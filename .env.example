# Copy this file, rename the copy to ".env.local", and paste your Make.com
# webhook URL after the equals sign. Leave it empty to run fully offline.
VITE_WEBHOOK_URL=

# Optional: the Make.com webhook URL for the AI parcel check on the Send page.
# Leave it empty and the app uses its offline keyword check instead.
VITE_AI_WEBHOOK_URL=

# Optional: PostHog product analytics. Both must be set for events to be sent.
# The host depends on your PostHog region: US Cloud is https://us.i.posthog.com
# and EU Cloud is https://eu.i.posthog.com. Leave both empty to turn analytics off.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

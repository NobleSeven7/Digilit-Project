# Copy this file, rename the copy to ".env.local", and paste your Make.com
# webhook URL after the equals sign. Leave it empty to run fully offline.
VITE_WEBHOOK_URL=

# Optional: the Make.com webhook URL for the AI parcel check on the Send page.
# Leave it empty and the app uses its offline keyword check instead.
VITE_AI_WEBHOOK_URL=

# PostHog browser analytics configuration.
VITE_POSTHOG_KEY=phc_your_project_token
VITE_POSTHOG_HOST=https://your-posthog-host

# Optional: the shared backend (Supabase): real accounts, and data shared
# between devices. Both come from Supabase > Settings > API Keys. Use the
# PUBLISHABLE key (sb_publishable_...), never the secret key. Leave them
# empty and everything is kept in this browser with demo profiles.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
